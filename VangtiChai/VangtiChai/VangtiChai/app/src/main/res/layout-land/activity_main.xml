<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/padding_main">

    <!-- Top Taka Header -->
    <TextView
        android:id="@+id/tvTakaDisplay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Taka:"
        android:textSize="@dimen/text_size_header"
        android:textColor="@android:color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Notes Breakdown (Two Columns in Landscape) -->
    <LinearLayout
        android:id="@+id/llNotesContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/margin_top_content"
        app:layout_constraintHorizontal_weight="2"
        app:layout_constraintTop_toBottomOf="@id/tvTakaDisplay"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/glKeypad">

        <!-- First Column (500, 100, 50, 20) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView android:id="@+id/tvNote500" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="500: 0" android:textSize="@dimen/text_size_list" />
            <TextView android:id="@+id/tvNote100" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100: 0" android:textSize="@dimen/text_size_list" />
            <TextView android:id="@+id/tvNote50"  android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="50: 0"  android:textSize="@dimen/text_size_list" />
            <TextView android:id="@+id/tvNote20"  android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="20: 0"  android:textSize="@dimen/text_size_list" />
        </LinearLayout>

        <!-- Second Column (10, 5, 2, 1) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView android:id="@+id/tvNote10"  android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10: 0"  android:textSize="@dimen/text_size_list" />
            <TextView android:id="@+id/tvNote5"   android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5: 0"   android:textSize="@dimen/text_size_list" />
            <TextView android:id="@+id/tvNote2"   android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2: 0"   android:textSize="@dimen/text_size_list" />
            <TextView android:id="@+id/tvNote1"   android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1: 0"   android:textSize="@dimen/text_size_list" />
        </LinearLayout>
    </LinearLayout>

    <!-- Keypad Table (Right Side) -->
    <TableLayout
        android:id="@+id/glKeypad"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_top_content"
        android:stretchColumns="*"
        app:layout_constraintHorizontal_weight="2"
        app:layout_constraintTop_toBottomOf="@id/tvTakaDisplay"
        app:layout_constraintStart_toEndOf="@id/llNotesContainer"
        app:layout_constraintEnd_toEndOf="parent">

        <TableRow>
            <Button android:id="@+id/btn1" android:text="1" android:textSize="@dimen/text_size_button" />
            <Button android:id="@+id/btn2" android:text="2" android:textSize="@dimen/text_size_button" />
            <Button android:id="@+id/btn3" android:text="3" android:textSize="@dimen/text_size_button" />
        </TableRow>

        <TableRow>
            <Button android:id="@+id/btn4" android:text="4" android:textSize="@dimen/text_size_button" />
            <Button android:id="@+id/btn5" android:text="5" android:textSize="@dimen/text_size_button" />
            <Button android:id="@+id/btn6" android:text="6" android:textSize="@dimen/text_size_button" />
        </TableRow>

        <TableRow>
            <Button android:id="@+id/btn7" android:text="7" android:textSize="@dimen/text_size_button" />
            <Button android:id="@+id/btn8" android:text="8" android:textSize="@dimen/text_size_button" />
            <Button android:id="@+id/btn9" android:text="9" android:textSize="@dimen/text_size_button" />
        </TableRow>

        <TableRow>
            <Button android:id="@+id/btn0" android:text="0" android:textSize="@dimen/text_size_button" />
            <Button
                android:id="@+id/btnClear"
                android:text="CLEAR"
                android:textSize="@dimen/text_size_button"
                android:layout_span="2" />
        </TableRow>
    </TableLayout>

</androidx.constraintlayout.widget.ConstraintLayout>